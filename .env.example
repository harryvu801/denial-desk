# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Model access ---
ANTHROPIC_API_KEY=sk-ant-...
MODEL_RESOLUTION=claude-sonnet-5-5          # the agent that resolves denials
MODEL_JUDGE=claude-opus-5-5                 # the eval judge — deliberately a different model, see ADR-014

# --- Database ---
# Default is a local SQLite file. For Postgres (make db-up):
# DATABASE_URL=postgresql+psycopg://denial:denial@localhost:5432/denial_desk
DATABASE_URL=sqlite:///data/denial_desk.db

# --- Budgets (enforced in code, see ADR-018) ---
MAX_AGENT_STEPS=8
MAX_TOKENS_PER_CLAIM=40000
MAX_USD_PER_CLAIM=0.25

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Behavior flags ---
RETRIEVAL_MIN_SCORE=0.35                    # below this the system refuses, see ADR-011
LOG_REDACTION=strict
